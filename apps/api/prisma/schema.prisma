generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignJoinPolicy {
  PUBLIC
  PRIVATE
}

enum CampaignCharacterStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
  DEAD
}

enum CampaignCharacterRole {
  MASTER
  PLAYER
  NPC
}

enum CampaignSceneGridShape {
  SQUARE
  HEX
}

enum CampaignTokenLayer {
  OBJECT
  TOKEN
  OVERLAY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  characters       Character[]
  createdCampaigns Campaign[]             @relation("CreatedCampaigns")
  campaignLinks    CampaignCharacter[]
  campaignMembers  CampaignMember[]
  chatMessages     ChatMessage[]
  assets           Asset[]
  campaignDiaries  CampaignDiary[]
  campaignSettings CampaignUserSettings[]
  createdAreaTemplates CampaignAreaTemplate[] @relation("AreaTemplateCreator")
  createdAreaEffects   SceneAreaEffect[]      @relation("AreaEffectCreator")
}

model Campaign {
  id          String             @id @default(cuid())
  title       String
  description String?
  inviteCode  String             @unique
  joinPolicy  CampaignJoinPolicy @default(PUBLIC)

  createdByUserId String
  createdByUser   User   @relation("CreatedCampaigns", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters     CampaignCharacter[]
  members        CampaignMember[]
  tokens         CampaignToken[]
  chatMessages   ChatMessage[]
  assets         CampaignAsset[]
  scenes         CampaignScene[]
  sceneViewState CampaignSceneViewState?
  diaries        CampaignDiary[]
  userSettings   CampaignUserSettings[]
  areaTemplates  CampaignAreaTemplate[]
  areaEffects    SceneAreaEffect[]
}

model Character {
  id        String    @id @default(cuid())
  userId    String
  name      String
  avatarUrl String?
  bio       String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  campaigns      CampaignCharacter[]
  chatMessages   ChatMessage[]
  campaignTokens CampaignToken[]

  @@index([userId])
  @@index([deletedAt])
}

model CampaignCharacter {
  id          String                  @id @default(cuid())
  campaignId  String
  characterId String                  @unique
  userId      String
  role        CampaignCharacterRole
  status      CampaignCharacterStatus @default(PENDING)
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  character Character @relation(fields: [characterId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  controlledTokens CampaignToken[] @relation("CampaignTokenController")

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  campaignId  String
  characterId String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  character Character @relation(fields: [characterId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([campaignId, createdAt])
  @@index([characterId])
  @@index([userId])
}

model Asset {
  id           String   @id @default(cuid())
  userId       String
  storagePath  String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  campaignAssets CampaignAsset[]
  campaignScenes CampaignScene[]

  @@index([userId])
}

model CampaignAsset {
  id         String   @id @default(cuid())
  campaignId String
  assetId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([campaignId, assetId])
  @@index([campaignId])
  @@index([assetId])
}

model CampaignScene {
  id                     String                 @id @default(cuid())
  campaignId             String
  name                   String
  order                  Int
  assetId                String?
  backgroundUrl          String?
  backgroundCacheKey     String?
  gridVisible            Boolean                @default(true)
  gridShape              CampaignSceneGridShape @default(SQUARE)
  gridSize               Int                    @default(32)
  metersPerCell          Float                  @default(1)
  squareMeasurementColor String                 @default("#facc15")
  hexMeasurementColor    String                 @default("#38bdf8")
  gridLineWidth          Int                    @default(1)
  gridColor              String                 @default("#ffffff")
  walls                  Json                   @default("[]")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  campaign            Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset               Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  tokenPlacements     CampaignTokenPlacement[]
  activeForViewStates CampaignSceneViewState[] @relation("MasterActiveScene")
  forcedForViewStates CampaignSceneViewState[] @relation("ForcedScene")
  areaEffects         SceneAreaEffect[]

  @@unique([campaignId, order])
  @@index([campaignId])
  @@index([assetId])
}

model CampaignAreaTemplate {
  id                    String   @id @default(cuid())
  campaignId            String
  createdByUserId       String
  name                  String
  description           String?
  category              String?
  tags                  Json     @default("[]")
  iconAssetId           String?
  shape                 String
  volumeShape           String
  dimensions            Json
  measurementMode       String
  measurementUnit       String?
  originMode            String
  placementMode         String
  propagationMode       String
  persistenceMode       String
  movementMode          String
  cellInclusionRule     String
  tokenIntersectionRule String
  includesOrigin        Boolean  @default(true)
  stopAtFirstObstacle   Boolean  @default(false)
  duration              Json?
  style                 Json
  visibility            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdByUser User              @relation("AreaTemplateCreator", fields: [createdByUserId], references: [id])
  areaEffects   SceneAreaEffect[]

  @@index([campaignId, name])
  @@index([createdByUserId])
}

model SceneAreaEffect {
  id                    String   @id @default(cuid())
  campaignId            String
  sceneId               String
  templateId            String?
  createdByUserId       String
  sourceTokenId         String?
  targetTokenId         String?
  originX               Float
  originY               Float
  originElevation       Float?
  rotationDegrees       Float    @default(0)
  scale                 Float    @default(1)
  configurationSnapshot Json
  state                 String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  expiresAt             DateTime?

  campaign      Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene         CampaignScene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  template      CampaignAreaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdByUser User                 @relation("AreaEffectCreator", fields: [createdByUserId], references: [id])

  @@index([campaignId, sceneId, state])
  @@index([templateId])
  @@index([createdByUserId])
}

model CampaignToken {
  id                     String   @id @default(cuid())
  campaignId             String
  characterId            String?  @unique
  controllerMemberId     String?
  name                   String
  avatarUrl              String?
  color                  String?
  size                   Float    @default(1)
  canCustomizeAppearance Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character        Character?              @relation(fields: [characterId], references: [id], onDelete: SetNull)
  controllerMember CampaignMember?         @relation("CampaignTokenController", fields: [controllerMemberId], references: [id], onDelete: SetNull)
  placement        CampaignTokenPlacement?

  @@index([campaignId])
  @@index([controllerMemberId])
}

model CampaignTokenPlacement {
  id        String             @id @default(cuid())
  tokenId   String             @unique
  sceneId   String
  hidden    Boolean            @default(false)
  positionX Float
  positionY Float
  rotation  Float              @default(0)
  layer     CampaignTokenLayer @default(TOKEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  token CampaignToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  scene CampaignScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

model CampaignSceneViewState {
  id                  String   @id @default(cuid())
  campaignId          String   @unique
  masterActiveSceneId String?
  forcedSceneId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  masterActiveScene CampaignScene? @relation("MasterActiveScene", fields: [masterActiveSceneId], references: [id], onDelete: SetNull)
  forcedScene       CampaignScene? @relation("ForcedScene", fields: [forcedSceneId], references: [id], onDelete: SetNull)

  @@index([masterActiveSceneId])
  @@index([forcedSceneId])
}

model CampaignDiary {
  id           String   @id @default(cuid())
  campaignId   String
  title        String
  content      String   @default("")
  createdById  String
  lastEditedBy String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([campaignId])
  @@index([createdById])
}

model CampaignUserSettings {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  settings   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
}
