generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CampaignJoinPolicy {
  PUBLIC
  PRIVATE
}

enum GameSystem {
  PATHFINDER_2E
}

enum CampaignMemberStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
}

enum CampaignMemberRole {
  MASTER
  PLAYER
}

enum CampaignSceneGridShape {
  SQUARE
  HEX
}

enum CampaignTokenLayer {
  OBJECT
  TOKEN
  OVERLAY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  createdCampaigns                Campaign[]              @relation("CreatedCampaigns")
  campaignMembers                 CampaignMember[]
  chatMessages                    ChatMessage[]
  assets                          Asset[]
  campaignDiaries                 CampaignDiary[]
  campaignSettings                CampaignUserSettings[]
  createdAreaTemplates            CampaignAreaTemplate[]  @relation("AreaTemplateCreator")
  createdAreaEffects              SceneAreaEffect[]       @relation("AreaEffectCreator")
  createdCampaignCharacterSheets CampaignCharacterSheet[] @relation("CampaignCharacterSheetCreator")
}

model Campaign {
  id          String             @id @default(cuid())
  title       String
  description String?
  inviteCode  String             @unique
  joinPolicy  CampaignJoinPolicy @default(PUBLIC)
  gameSystem  GameSystem

  createdByUserId String
  createdByUser   User   @relation("CreatedCampaigns", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         CampaignMember[]
  actors          CampaignActor[]
  tokens          CampaignToken[]
  chatMessages    ChatMessage[]
  assets          CampaignAsset[]
  scenes          CampaignScene[]
  sceneViewState  CampaignSceneViewState?
  diaries         CampaignDiary[]
  userSettings    CampaignUserSettings[]
  areaTemplates   CampaignAreaTemplate[]
  areaEffects     SceneAreaEffect[]
}

model CampaignActor {
  id                 String    @id @default(cuid())
  campaignId         String
  controllerMemberId String?
  name               String
  avatarUrl          String?
  bio                String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  controllerMember CampaignMember? @relation("CampaignActorController", fields: [controllerMemberId], references: [id], onDelete: SetNull)
  inventory        Inventory?
  characterSheet   CampaignCharacterSheet?
  token            CampaignToken?
  chatMessages     ChatMessage[]

  @@index([campaignId, archivedAt, createdAt])
  @@index([controllerMemberId])
}

model Inventory {
  id        String   @id @default(cuid())
  actorId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actor   CampaignActor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  entries InventoryEntry[]
}

model InventoryEntry {
  id               String   @id @default(cuid())
  inventoryId      String
  quantity         Int      @default(1)
  slotIndex        Int?
  catalogNamespace String?
  catalogContentId String?
  data             Json
  state            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, slotIndex])
  @@index([inventoryId, createdAt])
  @@index([catalogNamespace, catalogContentId])
}

model CampaignCharacterSheet {
  id              String   @id @default(cuid())
  actorId         String   @unique
  createdByUserId String
  systemKey       String
  schemaVersion   Int      @default(1)
  data            Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actor         CampaignActor                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  createdByUser User                          @relation("CampaignCharacterSheetCreator", fields: [createdByUserId], references: [id])
  entries       CampaignCharacterSheetEntry[]

  @@index([systemKey])
  @@index([createdByUserId])
}

model CampaignCharacterSheetEntry {
  id               String   @id @default(cuid())
  characterSheetId String
  namespace        String
  typeKey          String
  catalogNamespace String?
  catalogContentId String?
  schemaVersion    Int      @default(1)
  data             Json
  state            Json?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  characterSheet CampaignCharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)

  @@unique([characterSheetId, namespace, typeKey, catalogNamespace, catalogContentId], map: "CampaignCharacterSheetEntry_identity_key")
  @@index([characterSheetId, namespace, typeKey, sortOrder, createdAt], map: "CampaignCharacterSheetEntry_sheet_type_order_idx")
  @@index([catalogNamespace, catalogContentId], map: "CampaignCharacterSheetEntry_catalog_reference_idx")
}

model CampaignMember {
  id         String               @id @default(cuid())
  campaignId String
  userId     String
  role       CampaignMemberRole
  status     CampaignMemberStatus @default(PENDING)
  joinedAt   DateTime?
  leftAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  controlledActors CampaignActor[] @relation("CampaignActorController")
  controlledTokens CampaignToken[] @relation("CampaignTokenController")

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model ChatMessage {
  id                     String             @id @default(cuid())
  campaignId             String
  actorId                String?
  userId                 String?
  authorName             String
  authorRole             CampaignMemberRole
  actorNameSnapshot      String?
  actorAvatarUrlSnapshot String?
  content                String
  createdAt              DateTime           @default(now())

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor    CampaignActor? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([actorId])
  @@index([userId])
}

model Asset {
  id           String   @id @default(cuid())
  userId       String
  storagePath  String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id])
  campaignAssets  CampaignAsset[]
  campaignScenes  CampaignScene[]

  @@index([userId])
}

model CampaignAsset {
  id         String   @id @default(cuid())
  campaignId String
  assetId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([campaignId, assetId])
  @@index([campaignId])
  @@index([assetId])
}

model CampaignScene {
  id                     String                 @id @default(cuid())
  campaignId             String
  name                   String
  order                  Int
  assetId                String?
  backgroundUrl          String?
  backgroundCacheKey     String?
  gridVisible            Boolean                @default(true)
  gridShape              CampaignSceneGridShape @default(SQUARE)
  gridSize               Int                    @default(32)
  gridOffsetX            Int                    @default(0)
  gridOffsetY            Int                    @default(0)
  metersPerCell          Float                  @default(1)
  squareMeasurementColor String                 @default("#facc15")
  hexMeasurementColor    String                 @default("#38bdf8")
  gridLineWidth          Int                    @default(1)
  gridColor              String                 @default("#ffffff")
  walls                  Json                   @default("[]")
  fogConfig              Json                   @default("{}")
  fixedLightSources      Json                   @default("[]")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  campaign            Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  asset               Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  tokenPlacements     CampaignTokenPlacement[]
  activeForViewStates CampaignSceneViewState[] @relation("MasterActiveScene")
  forcedForViewStates CampaignSceneViewState[] @relation("ForcedScene")
  areaEffects         SceneAreaEffect[]
  fogExplorations     CampaignFogExploration[]

  @@unique([campaignId, order])
  @@index([campaignId])
  @@index([assetId])
}

model CampaignAreaTemplate {
  id                    String   @id @default(cuid())
  campaignId            String
  createdByUserId       String
  name                  String
  description           String?
  category              String?
  tags                  Json     @default("[]")
  iconAssetId           String?
  shape                 String
  volumeShape           String
  dimensions            Json
  measurementMode       String
  measurementUnit       String?
  originMode            String
  placementMode         String
  propagationMode       String
  persistenceMode       String
  movementMode          String
  cellInclusionRule     String
  tokenIntersectionRule String
  includesOrigin        Boolean  @default(true)
  stopAtFirstObstacle   Boolean  @default(false)
  duration              Json?
  style                 Json
  visibility            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdByUser User               @relation("AreaTemplateCreator", fields: [createdByUserId], references: [id])
  areaEffects   SceneAreaEffect[]

  @@index([campaignId, name])
  @@index([createdByUserId])
}

model SceneAreaEffect {
  id                    String   @id @default(cuid())
  campaignId            String
  sceneId               String
  templateId            String?
  createdByUserId       String
  sourceTokenId         String?
  targetTokenId         String?
  originX               Float
  originY               Float
  originElevation       Float?
  rotationDegrees       Float    @default(0)
  scale                  Float    @default(1)
  configurationSnapshot Json
  state                 String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  expiresAt             DateTime?

  campaign      Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scene         CampaignScene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  template      CampaignAreaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdByUser User                  @relation("AreaEffectCreator", fields: [createdByUserId], references: [id])

  @@index([campaignId, sceneId, state])
  @@index([templateId])
  @@index([createdByUserId])
}

model CampaignToken {
  id                     String   @id @default(cuid())
  campaignId             String
  actorId                String?  @unique
  controllerMemberId     String?
  name                   String
  avatarUrl              String?
  color                  String?
  size                   Float    @default(1)
  canCustomizeAppearance Boolean  @default(false)
  visionConfig           Json     @default("{}")
  lightConfig            Json     @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campaign         Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor            CampaignActor?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  controllerMember CampaignMember?          @relation("CampaignTokenController", fields: [controllerMemberId], references: [id], onDelete: SetNull)
  placement        CampaignTokenPlacement?
  fogExplorations  CampaignFogExploration[]

  @@index([campaignId])
  @@index([controllerMemberId])
}

model CampaignTokenPlacement {
  id                   String             @id @default(cuid())
  tokenId              String             @unique
  sceneId              String
  hidden               Boolean            @default(false)
  positionX            Float
  positionY            Float
  rotation             Float              @default(0)
  layer                CampaignTokenLayer @default(TOKEN)
  blocksVisionAndLight Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  token CampaignToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  scene CampaignScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

model CampaignFogExploration {
  id         String   @id @default(cuid())
  sceneId    String
  tokenId    String
  revision   Int      @default(0)
  mask       Bytes?
  maskWidth  Int      @default(0)
  maskHeight Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scene CampaignScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  token CampaignToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([sceneId, tokenId])
  @@index([tokenId])
}

model CampaignSceneViewState {
  id                  String   @id @default(cuid())
  campaignId          String   @unique
  masterActiveSceneId String?
  forcedSceneId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  masterActiveScene CampaignScene? @relation("MasterActiveScene", fields: [masterActiveSceneId], references: [id], onDelete: SetNull)
  forcedScene       CampaignScene? @relation("ForcedScene", fields: [forcedSceneId], references: [id], onDelete: SetNull)

  @@index([masterActiveSceneId])
  @@index([forcedSceneId])
}

model CampaignDiary {
  id           String   @id @default(cuid())
  campaignId   String
  title        String
  content      String   @default("")
  createdById  String
  lastEditedBy String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([campaignId])
  @@index([createdById])
}

model CampaignUserSettings {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  settings   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
}
